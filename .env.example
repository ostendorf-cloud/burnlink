# Copy to .env and adjust for docker compose. docker-compose.yaml reads this
# file itself; bin/burnlink needs STORE_ADDR and has a usable default for
# everything else.

# Address the public HTTP server listens on.
# ADDR=:8080

# Address govue's admin listener listens on: /healthz, /readyz and /metrics.
# ADMIN_ADDR=:8081

# debug, info, warn or error.
# LOG_LEVEL=info

# The Redis-compatible store, host:port. Required. docker-compose.yaml sets
# it to its own Valkey service.
# STORE_ADDR=127.0.0.1:6379

# Store credentials, both optional. Each one is read directly or from the
# file named by its _FILE twin, never both. Prefer the file form outside
# local development. Never commit a real value.
# STORE_USERNAME=
# STORE_USERNAME_FILE=
# STORE_PASSWORD=
# STORE_PASSWORD_FILE=

# true to connect to the store over TLS.
# STORE_TLS=false

# CIDRs of the reverse proxies whose X-Forwarded-For entry is trusted, comma
# separated. Empty trusts none: every request is attributed to its TCP peer.
# TRUSTED_PROXIES=

# Largest ciphertext accepted, in bytes.
# SECRET_MAX_BYTES=1048576

# Shortest, longest and default lifetime of a secret. Go durations or whole
# days, for example 30s, 12h or 7d.
# SECRET_LIFETIME_MIN=1m
# SECRET_LIFETIME_MAX=7d
# SECRET_LIFETIME_DEFAULT=24h

# Per client address budget of the secret endpoints: this many requests at
# once, refilled completely every RATE_LIMIT_PER.
# RATE_LIMIT_BURST=10
# RATE_LIMIT_PER=1m

# Page view counting through Umami, from the server. Off unless both
# UMAMI_URL and UMAMI_WEBSITE_ID are set. Setting one alone is a startup
# error. Neither value is a secret. SITE_HOST is the public host reported with
# every view and is required when counting is on.
# UMAMI_URL=https://umami.example.com
# UMAMI_WEBSITE_ID=
# SITE_HOST=burnlink.example.com
# UMAMI_TIMEOUT=5s
# UMAMI_QUEUE_SIZE=256
