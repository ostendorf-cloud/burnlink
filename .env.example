# Copy to .env and adjust for docker compose. There is no secret-shaped
# configuration yet: no crypto, no store client and no API routes exist, so
# none of these need the envconf "_FILE" convention. docker-compose.yaml
# reads this file itself; bin/burnlink also runs with none of these set,
# since every one of them has a usable default.

# Address the public HTTP server listens on.
# ADDR=:8080

# Address govue's admin listener listens on: /healthz, /readyz and /metrics.
# ADMIN_ADDR=:8081

# debug, info, warn or error.
# LOG_LEVEL=info
