# Copy to .env and adjust for docker compose. docker-compose.yaml reads this
# file itself; bin/burnlink needs STORE_ADDR and has a usable default for
# everything else.

# Address the public HTTP server listens on.
# ADDR=:8080

# Address govue's admin listener listens on: /healthz, /readyz and /metrics.
# ADMIN_ADDR=:8081

# debug, info, warn or error.
# LOG_LEVEL=info

# The Redis-compatible store, host:port. Required. docker-compose.yaml sets
# it to its own Dragonfly service.
# STORE_ADDR=127.0.0.1:6379

# Store credentials, both optional. Each one is read directly or from the
# file named by its _FILE twin, never both. Prefer the file form outside
# local development. Never commit a real value.
# STORE_USERNAME=
# STORE_USERNAME_FILE=
# STORE_PASSWORD=
# STORE_PASSWORD_FILE=

# true to connect to the store over TLS.
# STORE_TLS=false
